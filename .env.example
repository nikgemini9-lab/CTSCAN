# Rettiwt API Key
# Get this via the "X Auth Helper" Chrome extension:
#   1. Install: https://chromewebstore.google.com/detail/x-auth-helper/...
#   2. Open Twitter in incognito, log in
#   3. Click the extension → Generate API Key
#   4. Paste the base64 string below
RETTIWT_API_KEY=your_api_key_here

# Hit thresholds
MIN_FOLLOWERS=3000
MIN_VIEWS=10000

# SQLite database file
DB_PATH=ctscan.db

# Max tweets to fetch per query page (20-100)
PAGE_SIZE=100

# Max pages to paginate per query (100 tweets each)
MAX_PAGES=5

# Milliseconds to wait between requests
REQUEST_DELAY_MS=1500
