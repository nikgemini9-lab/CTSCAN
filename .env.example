# Rettiwt API Key (required)
# Get via "X Auth Helper" Chrome extension:
#   1. Install from Chrome Web Store
#   2. Open Twitter in incognito mode, log in
#   3. Click extension → Generate API Key → copy base64 string
RETTIWT_API_KEY=your_api_key_here

# Hit thresholds
MIN_FOLLOWERS=3000
MIN_VIEWS=10000

# SQLite DB path (use /data/ctscan.db on Render with persistent disk)
DB_PATH=ctscan.db

# Scraper settings
PAGE_SIZE=100
MAX_PAGES=5
REQUEST_DELAY_MS=1500

# Server port (Render sets this automatically)
PORT=3000
