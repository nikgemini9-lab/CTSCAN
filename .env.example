# Twitter / X API Credentials
# Get these from https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_bearer_token_here
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# Scraper Settings
MIN_FOLLOWERS=3000          # Minimum followers to qualify as a hit
MIN_IMPRESSIONS=10000       # Minimum tweet impressions to qualify as a hit
DB_PATH=ctscan.db           # SQLite database file path
REQUEST_DELAY=1.0           # Seconds between API calls (rate limit safety)
MAX_RESULTS_PER_QUERY=100   # Max tweets per search query (10-100)
